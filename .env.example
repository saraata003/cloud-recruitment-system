# Copy this file to .env.local and adjust as needed. Every value below has a
# working default, so the app runs with zero configuration out of the box.

# Set this on a host with a persistent volume/disk (e.g. Railway) to its
# mount path. The database and uploaded photos/CVs relocate there
# automatically, so they survive restarts and redeploys instead of living on
# the container's throwaway filesystem. Leave unset for local development —
# everything defaults to ./data.
STORAGE_DIR=

# Where the SQLite database file lives. Overrides STORAGE_DIR for the
# database specifically, if you want it somewhere else.
DATABASE_PATH=./data/drinkat.db

# Optional. Without this, CV summaries and interview questions are generated
# by a built-in rule-based engine (fast, free, no external calls). Set a real
# key to switch on full AI-generated summaries and tailored interview
# questions via Claude.
ANTHROPIC_API_KEY=

# Model used for AI features when ANTHROPIC_API_KEY is set.
ANTHROPIC_MODEL=claude-sonnet-5

# Country code used to normalize phone numbers for duplicate-applicant
# detection and to build wa.me WhatsApp links. Digits only, no "+".
DEFAULT_COUNTRY_CODE=962

# Maximum upload size (in MB) for photos and CVs.
MAX_UPLOAD_MB=8
