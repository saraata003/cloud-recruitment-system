# PIN for the kitchen screen and admin pages
STAFF_PIN=1234

# Where the SQLite database and uploaded images live (default: ./data)
# DATA_DIR=./data

# Foodics (leave empty to keep using the mock)
FOODICS_API_URL=https://api.foodics.com/v5
