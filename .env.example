# Payments: "mock" for now. Add a real provider in src/lib/services/payments.ts
PAYMENT_PROVIDER=mock

# Notifications (SMS / WhatsApp) – leave empty to only use in-app notifications
SMS_PROVIDER=
WHATSAPP_PROVIDER=
